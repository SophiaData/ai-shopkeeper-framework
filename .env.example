# 环境变量样例：只列变量名，真实密钥一律进 .env（已 gitignore）
# 复制为 .env 后填值：copy .env.example .env

# ---- LLM 通道（A2 裁决：主走本机 magpie 网关，公网 agnes 备路）----
SHOPKEEPER_LLM_BASE_URL=http://127.0.0.1:3425/v1
SHOPKEEPER_LLM_MODEL=group/auto-deepseek-v4-1-flash
SHOPKEEPER_LLM_API_KEY=local-gateway-no-auth
# 主模型超时/5xx/限流时切换备用；全部失败回落本地模板并标 degraded（占位，勿写真实密钥）。
# LLM_FALLBACK_MODELS 为逗号分隔额外备用（在 LLM_FALLBACK_MODEL 之后）。
# LLM_FALLBACK_BASE_URL 留空则复用 SHOPKEEPER_LLM_BASE_URL。备用调用计入 LLM_DAILY_BUDGET_USD。
LLM_FALLBACK_MODEL=
LLM_FALLBACK_MODELS=
LLM_FALLBACK_BASE_URL=

# ---- 图像通道（A3 裁决：Pillow 主链路；M2 真重绘可选）----
SHOPKEEPER_IMAGE_BASE_URL=http://127.0.0.1:3425/v1
SHOPKEEPER_IMAGE_MODEL=workbuddy/hunyuan-image-v3.0-art
# 真重绘默认关。=1 时 listing 管线走 ImageRedrawAdapter，重绘后必跑水印检测。
# IMAGE_REDRAW_ADAPTER=mock|stub；stub 不外呼（本机网关无 edits，见 docs/spike/image.md）。
IMAGE_REDRAW_ENABLED=0
IMAGE_REDRAW_ADAPTER=mock

# ---- 商品图托管 ImageStore（默认本地 artifacts；S3 仅显式启用）----
# IMAGE_STORE=local|s3。默认 local → LocalFileImageStore（内容哈希命名去重）。
# IMAGE_STORE_DIR 留空则用 {ARTIFACTS_DIR}/image_store。
# IMAGE_STORE=s3 且下方 ENDPOINT/BUCKET/ACCESS_KEY/SECRET_KEY 齐全才启用 S3 兼容骨架；
# 否则回退本地，不外呼。真实密钥只写 .env，勿提交。不解锁 TTS_WRITE_*。
IMAGE_STORE=local
IMAGE_STORE_DIR=
IMAGE_STORE_S3_ENDPOINT=
IMAGE_STORE_S3_BUCKET=
IMAGE_STORE_S3_ACCESS_KEY=
IMAGE_STORE_S3_SECRET_KEY=
IMAGE_STORE_S3_REGION=us-east-1
IMAGE_STORE_S3_PREFIX=
IMAGE_STORE_S3_PUBLIC_BASE_URL=

# ---- 语种与站点（M1-PLAN §0：不硬编码，改配置不改代码）----
LISTING_LANGS=EN,TH,VI
TARGET_SITE=SEA

# ---- 适配器选择（mock 先行，逐个替换）----
# PRODUCT_SOURCE=mock|alibaba_1688；真货源另需 ALIBABA_1688_ENABLED=1 + 下方凭据占位。
PRODUCT_SOURCE=mock
LLM_CHANNEL=mock
IMAGE_CHANNEL=mock

# ---- 数据层 ----
DATABASE_URL=sqlite:///./artifacts/shopkeeper.db
# 工作台 SQLite 启动时跑版本化迁移（schema_version）；连接启用 WAL + busy_timeout=30s。
# artifacts 备份：sqlite3 backup API 一致性拷贝全部 .db + 审计 jsonl。
# BACKUP_DAILY：.env.example / 本机默认 0；docker-compose 生产向默认 1（可在 .env 覆盖）。
# =1 时曼谷 22:30 由调度器备份。恢复须 --confirm YES。
ARTIFACTS_DIR=artifacts
BACKUP_DIR=artifacts/backups
BACKUP_KEEP=14
BACKUP_DAILY=0

# ---- 1688 采集 / Open API 货源骨架（默认关 → MockProductSource）----
# 页面 Cookie 仅在 A1 页面解析路径需要时使用；Open API 用下方三件套。
# 真实密钥只写 .env，勿提交本文件或 Git。ALIBABA_1688_ENABLED=0 时不外呼。
# ALIBABA_COOKIE=
ALIBABA_1688_ENABLED=0
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_ACCESS_TOKEN=
ALIBABA_1688_API_BASE=https://gw.open.1688.com/openapi
# ALIBABA_1688_NAMESPACE=com.alibaba.product
# ALIBABA_1688_API_NAME=alibaba.agent.product.simple.get
# ALIBABA_1688_API_VERSION=1
# 真 API 只读集成（make test-real / docs/REAL-TESTS.md）用的探测 offer；勿提交真值。
# ALIBABA_1688_TEST_OFFER_ID=
# ALIBABA_1688_TEST_OFFER_URL=

# 1688 代发：mock（默认，本地假单号）或 manual（可复制的下单信息，人工回填单号）。
# 没有 live / pay 档。两种模式都不调用 1688 下单接口、都不付款。
# ALIBABA_DROPSHIP_MODE=mock

# ---- demo 产物目录 ----
DEMO_OUTPUT_DIR=artifacts/demo
MOCK_DELAY_MS=0

# ---- 泰国站工作台 ----
# 本地试用（不接真店）：保持 WORKFLOW_PLATFORM=mock 与 WORKFLOW_LLM_PROVIDER=mock。
# 真实令牌只写在 .env。不要填卖家中心 Cookie。发货、付款、退款没有自动开关。
# 平台适配器：空=有凭据则 tiktok 只读（写仍拒绝）/无凭据则 offline；
# mock=本地写通道验收；tiktok_dry_run=真实凭据下预检不外呼写接口；
# tiktok_live=真写（另需 TTS_WRITE_* 放行，见下）；rpa_stub=RPA 占位。
WORKFLOW_PLATFORM=mock
WORKFLOW_HOST=127.0.0.1
# 本机开发常用 8000；Docker / systemd 示例默认 8780（见 docker-compose.yml、deploy/shopkeeper.service）。
WORKFLOW_PORT=8000
# 留空时 /api/workflow 只接受本机回环。设置后，请求须带 X-Workflow-Token。
# GET /healthz 始终无鉴权，只返回 ok/version/publish_enabled。
# 机器调用兼容：有管理员后，写类 API 仍可用此 Token 绕过会话。
WORKFLOW_API_TOKEN=
WORKFLOW_SCHEDULER=1
# 单机默认内联 worker；多进程/容器部署设 0，并另起 `python -m shopkeeper.workflow.worker`。
WORKFLOW_WORKER_INLINE=1
# 设 1 时 /readyz 要求至少一个新鲜 worker 心跳；单进程本地预览可保持 0。
WORKFLOW_REQUIRE_WORKER=0
# /readyz 是否要求最近备份新鲜；单机建议生产开启。
WORKFLOW_REQUIRE_BACKUP=0
WORKFLOW_BACKUP_MAX_AGE_S=129600
# 优雅停机等待上限；超时则保留实例锁并由进程退出释放。
WORKFLOW_SHUTDOWN_TIMEOUT_S=30
WORKFLOW_WORKER_POLL_S=1.0
WORKFLOW_WORKER_LEASE_S=90
# 分离 worker：设 WORKFLOW_WORKER_INLINE=0 并运行 python -m shopkeeper.workflow.worker；见 docs/PRODUCTION.md。
WORKFLOW_DB_PATH=artifacts/workflow.db
WORKFLOW_TIMEZONE=Asia/Bangkok

# ---- 管理后台登录（/admin）----
# CLI：PYTHONPATH=src python3 -m shopkeeper.workflow.admin_cli create-user --username owner --password '...' --role owner
# 会话 cookie：sk_session（HttpOnly）+ sk_csrf；写请求带 X-CSRF-Token。
# 会话 cookie 的 Secure（P1-06）：留空=按来源自动判定——本机 loopback 不加
# （否则 http 下浏览器不回传 cookie，登录直接失效），非本机来源自动加。
# 显式 1/0 则以此为准，不做推断。
# ADMIN_COOKIE_SECURE=
ADMIN_COOKIE_SAMESITE=lax
ADMIN_SESSION_HOURS=12
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_SHOP_NAME=泰国站 · 家居收纳
ADMIN_SHOP_ID=shop_th_home
# 只接受 https。不要填内网、回环或云元数据地址。可用 WORKFLOW_WEBHOOK_HOSTS 收成逗号分隔的主机名。
WORKFLOW_WEBHOOK_URL=
RESEARCH_INPUT_PATH=
RESEARCH_OUTPUT_PATH=
DAILY_METRICS_PATH=
DAILY_REPORT_OUTPUT=

# 文案提供方：mock | openai | coze | dify。本地试用用 mock；缺令牌时也会退回 mock。
WORKFLOW_LLM_PROVIDER=mock
WORKFLOW_LLM_API_KEY=
WORKFLOW_LLM_BASE_URL=
WORKFLOW_LLM_MODEL=

# Coze 开放平台。国际站默认 https://api.coze.com ，国内站换成你的域名。
COZE_API_TOKEN=
COZE_BOT_ID=
COZE_API_BASE=https://api.coze.com

# Dify 的 API 根通常以 /v1 结尾。
DIFY_API_KEY=
DIFY_API_BASE=
DIFY_APP_USER=shopkeeper-th

# TikTok Shop Open API（202309）。三个核心值都在才请求平台；否则工作台保持离线。
# 多店铺最小切片：TIKTOK_SHOPS=逗号分隔 shop_id；空=仅 default（向后兼容）。
# 每店凭据：TIKTOK_<SHOP_ID 大写>_APP_KEY 等（-→_）；default 可继续用下方无前缀变量。
# 真实密钥只写 .env，勿提交。不解锁 TTS_WRITE_*。
TIKTOK_SHOPS=default
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN_EXPIRE_AT=
TIKTOK_SHOP_CIPHER=
TIKTOK_SHOP_REGION=TH
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_BASE=https://auth.tiktok-shops.com
# 例（第二店，占位）：TIKTOK_TH_HOME_APP_KEY= / TIKTOK_TH_HOME_APP_SECRET= / TIKTOK_TH_HOME_ACCESS_TOKEN= / TIKTOK_TH_HOME_SHOP_CIPHER=

# ---- TikTok 真写放行（仅 WORKFLOW_PLATFORM=tiktok_live）----
# 默认全关。须同时：TTS_WRITE_ENABLED=1，且 TIKTOK_SHOP_CIPHER 落在白名单。
# 不要把真实密钥写进本文件或 Git。验收步骤见 docs/phase5-real-listing-acceptance.md。
TTS_WRITE_ENABLED=0
TTS_WRITE_SHOP_ALLOWLIST=
TTS_WRITE_DAILY_LIMIT=1
TTS_WRITE_MAX_PER_REQUEST=1
TTS_WRITE_AUDIT_PATH=artifacts/tts_write_audit.jsonl
# 真实物流写入所需的 TikTok 承运商 ID（Open API shipping_provider_id）。
TIKTOK_SHIPPING_PROVIDER_ID=

# ---- 承运方单号查询（只读，P2-03）----
# 默认关。承运商格式正则始终执行，不依赖本开关。
# 设为 1 时，物流 push 在回传平台前对已通过格式的单号发一次 GET。
# URL 可用 {carrier} 与 {tracking_no}；两个都没有时自动补 query。
# 只允许 http/https，不跟随重定向，不发送 POST。令牌放 BEARER，不要写进 URL。
# 未配置 URL、非 200、超时、响应不是带布尔 found 的 JSON，都拒绝回传。
# 不打开 TTS_WRITE_*，不打开发货、退款、付款。
TRACKING_LOOKUP_ENABLED=0
TRACKING_LOOKUP_URL=
TRACKING_LOOKUP_BEARER=
TRACKING_LOOKUP_TIMEOUT_S=5

# ---- TikTok Ads 只读花费（P3-04）----
# 默认关。打开后只 GET 官方同步报表与广告主币种，把 spend 记成 THB satang。
# 不改预算、不建计划、不调用 campaign/update 或 advertiser/update。
# 币种不是 THB 时拒绝入库，不自行换汇。令牌只放 ACCESS_TOKEN，不要写进 URL。
# 不打开 TTS_WRITE_*，不打开发货、退款、付款。
TIKTOK_ADS_ENABLED=0
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=
# 只能是官方基址；留空即用该默认。不要改成别的主机。
TIKTOK_ADS_API_BASE=https://business-api.tiktok.com/open_api/v1.3
TIKTOK_ADS_TIMEOUT_S=20

# ---- 外部调用统一重试（生成类 / 可重试传输；执行类写操作不走自动重试）----
# 指数退避 + 抖动；上限可配。默认 max_retries=2（共 3 次尝试）。
# 有副作用的写操作另走幂等键（external_writes.idempotency_key，migrate v6）。
RETRY_MAX_RETRIES=2
RETRY_BACKOFF_BASE_S=0.05
RETRY_BACKOFF_MAX_S=2.0
RETRY_JITTER_RATIO=1.0

# ---- 客服白名单自动回复（DESIGN §6 / §9 M3）----
# 逗号分隔类目；默认 logistics_query,tracking_status,sla_reminder。
# 仅低风险物流/时效类可免审 stub 发送（sent_stub/dry_run，不外呼 TikTok 客服 API）。
# 退款/赔偿/差价/投诉等硬闸必审（即便写进本变量也不会免审）。
# 收件箱只读拉取没有开关：本仓库无客服消息端点契约，不提供会外呼的 CS_INBOX_* 变量。
# POST /api/workflow/cs/inbox/pull 固定返回 stub（未臆造端点）。回复发送也不外呼。
CS_AUTO_REPLY_CATEGORIES=logistics_query,tracking_status,sla_reminder

# ---- 平台操作网关（DESIGN §2.1：主系统与海外侧可分离）----
# local=同进程直连 PlatformAdapter（默认）；remote=入队 + 海外 GatewayServer 长轮询领任务。
# GATEWAY_TOKEN 只写 .env，勿提交。发货/退款在网关层硬拒（403 口径）。
GATEWAY_MODE=local
GATEWAY_TOKEN=
GATEWAY_HUB_BASE_URL=http://127.0.0.1:8090
GATEWAY_HUB_HOST=127.0.0.1
GATEWAY_HUB_PORT=8090
GATEWAY_CLAIM_WAIT_SECONDS=2
GATEWAY_RESULT_TIMEOUT_SECONDS=10

# ---- 飞书审批卡片 + 回调 ----
# 创建 listing 审批单时发互动卡片（标题/摘要/批准|拒绝）。
# FEISHU_NOTIFY=0（默认）：只写入 FEISHU_CARD_DIR，不外呼。
# FEISHU_NOTIFY=1 且配置 FEISHU_WEBHOOK_URL 时才尝试 webhook；失败降级 stub，不阻断建单。
# /feishu/approval-callback：验签用 FEISHU_ENCRYPT_KEY（优先）或 body.token=FEISHU_VERIFICATION_TOKEN。
# 验签失败 → 401。勿把真实密钥写入本文件或 Git。
FEISHU_NOTIFY=0
FEISHU_CARD_DIR=artifacts/feishu/cards
FEISHU_WEBHOOK_URL=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
# 仅本地单测可设 1；生产勿开。
FEISHU_CALLBACK_ALLOW_INSECURE=0

# ---- AI 工作流编排器（DESIGN §3.1 / §5）----
# ORCHESTRATOR_AUTORUN=0 默认关；=1 时调度器每日按候选 URL 自动开 run 并推进到审批挂起。
# 候选：ORCHESTRATOR_AUTORUN_URLS（逗号分隔）或 RESEARCH_INPUT_PATH CSV 的 url 列。
# LLM_DAILY_BUDGET_USD 留空=不限额；超出则 run 进入 budget_paused 并告警 LLM_BUDGET_EXCEEDED。
# 主备模型（LLM_FALLBACK_MODEL 等）成功调用均计入本预算；本地模板降级不计费。
# 无真实 SHOPKEEPER_LLM_API_KEY 时编排器走 mock（与 LLM_CHANNEL=mock 一致），CI 可跑。
ORCHESTRATOR_AUTORUN=0
ORCHESTRATOR_AUTORUN_LIMIT=3
ORCHESTRATOR_AUTORUN_URLS=
# ORCHESTRATOR_ORDER_AUTORUN=0 默认关；=1 时调度线程周期性把已同步订单接入独立的
# order_fulfillment_v1（按 order_id+shop_id 幂等）；只在审批通过后自动继续，不重试失败/挂起步。
ORCHESTRATOR_ORDER_AUTORUN=0
ORCHESTRATOR_ORDER_AUTORUN_LIMIT=5
LLM_DAILY_BUDGET_USD=

# ---- 售价公式占位费率（DESIGN §3.1 Pricing / §5）----
# 建议价 = ceil((cost_cny+shipping_cny)*FX_CNY_THB / (1 - 佣金 - 支付 - 广告 - 目标毛利))
# 金额：cost/shipping=CNY 分；suggested/min=THB satang。FX 为固定占位，非实时汇率源。
# 编排器定价步优先用公式；LLM 覆盖价偏离超 PRICING_DEVIATION_PCT → 挂起 pricing_override。
# 预览：POST /api/workflow/pricing/quote 或 python -m shopkeeper.cli pricing-quote --cost-cny 1000
FX_CNY_THB=5.0
PRICING_FX_SOURCE=env:FX_CNY_THB
PRICING_COMMISSION_PCT=5
PRICING_PAYMENT_FEE_PCT=2
PRICING_ADS_PCT=0
PRICING_TARGET_MARGIN_PCT=25
PRICING_SHIPPING_CNY=0
PRICING_MIN_PRICE_THB=0
PRICING_DEVIATION_PCT=10

# ---- 结构化日志 + 任务失败告警（生产就绪 P0）----
# LOG_LEVEL 默认 INFO；LOG_FORMAT=text（清晰文本）或 json。
# 任务调度失败 / 审批执行失败 / 报表 webhook 与飞书推送失败会写 error 日志。
# 可选外呼：复用 FEISHU_NOTIFY + FEISHU_WEBHOOK_URL；另可设 WEBHOOK_ALERT_URL（默认空=不开）。
# 告警体只含 code / job_type / order_id，不含密钥。同类 code+order_id 默认 5 分钟最多 1 条。
# 日志与告警输出前自动脱敏买家 PII（姓名/电话/地址/聊天片段等）。
LOG_LEVEL=INFO
LOG_FORMAT=text
WEBHOOK_ALERT_URL=
ALERT_THROTTLE_SECONDS=300

# ---- 泰国 PDPA 配套：买家 PII 保留期（工程默认，非法律意见）----
# 过期后调度器覆写订单 payload / 客服会话正文中的 PII，保留订单号与金额等财务字段。
# PII_PURGE_DAILY 代码默认 0；泰国站建议 =1（曼谷 03:15）。
# PII_PURGE_DRY_RUN 代码默认 1：只写审计、不改库。真覆写须 owner 确认后改为 0。
# 手动演练：python -m shopkeeper.workflow.pii_retention --dry-run
# 备份 manifest 含同策略说明；历史备份目录可能仍含清理前明文，须自行轮转。
PII_RETENTION_DAYS=90
PII_PURGE_DAILY=1
PII_PURGE_DRY_RUN=1

# n8n 只是可选的外部提醒，工作台自己的定时任务不依赖它。
N8N_EDITOR_BASE_URL=http://127.0.0.1:5678
