{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Shopkeeper",
  "version": "0.1.0",
  "identifier": "com.gtk96.ai-shopkeeper",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:8000/workflow",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI 店长",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
